<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' · MOON' : 'MOON' %></title>
  <% const hasSidebar = currentUser && ['admin', 'sales_rep'].includes(currentUser.role) && !currentUser.mustChangePassword; %>
  <% const isThemed = hasSidebar || (typeof themed !== 'undefined' && themed); %>
  <% if (isThemed) { %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,700&display=swap" />
  <% } %>
  <link rel="stylesheet" href="/css/style.css" />
  <% if (isThemed) { %><link rel="stylesheet" href="/css/admin.css" /><% } %>
</head>
<body<%- hasSidebar ? ' class="admin-body"' : isThemed ? ' class="admin-body admin-body-top"' : '' %>>
