<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <div class="card receipt">
    <h1><%= store.store_name %></h1>
    <% if (store.store_address) { %><p class="muted" style="white-space: pre-line"><%= store.store_address %></p><% } %>
    <% if (store.store_contact) { %><p class="muted"><%= store.store_contact %></p><% } %>
    <p><strong>Receipt No:</strong> <%= sale.receipt_no %></p>
    <p><strong>Date:</strong> <%= sale.created_at %></p>
    <table class="table">
      <thead><tr><th>Item</th><th>Price</th><th>Qty</th><th>Subtotal</th></tr></thead>
      <tbody>
        <% items.forEach(i => { %>
          <tr>
            <td><%= i.product_name %></td>
            <td><%= peso(i.unit_price) %></td>
            <td><%= i.quantity %></td>
            <td><%= peso(i.subtotal) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr><td colspan="3">Total</td><td><%= peso(sale.total_amount) %></td></tr>
        <tr><td colspan="3">Payment</td><td><%= h.PAYMENT_LABELS[sale.payment_method] || 'Cash' %><%= sale.payment_ref ? ' · Ref ' + sale.payment_ref : '' %></td></tr>
        <tr><td colspan="3">Amount Paid</td><td><%= peso(sale.amount_paid) %></td></tr>
        <tr><td colspan="3">Change</td><td><%= peso(sale.change_amount) %></td></tr>
      </tfoot>
    </table>
    <% if (store.receipt_footer) { %><p class="muted" style="text-align: center; white-space: pre-line"><%= store.receipt_footer %></p><% } %>
    <div class="receipt-actions">
      <button onclick="window.print()" class="btn btn-secondary">Print</button>
      <a href="/pos" class="btn btn-primary">New Sale</a>
    </div>
  </div>
</main>
<%- include('../partials/foot') %>
