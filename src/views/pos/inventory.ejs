<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="page rep-page">
  <h1 class="page-title">Inventory</h1>

  <div class="panel">
    <h2 class="panel-title">Submit Inventory Report</h2>
    <form method="POST" action="/pos/inventory/report" class="form-grid">
      <label>Product
        <select class="ainput" name="product_id" required>
          <% products.forEach(p => { %>
            <option value="<%= p.id %>"><%= p.name %> (<%= p.stock_quantity %> <%= p.unit %> in stock)</option>
          <% }) %>
        </select>
      </label>
      <label>Type
        <select class="ainput" name="type" required>
          <option value="restock">Restock (received new stock)</option>
          <option value="damaged">Damaged</option>
          <option value="lost">Lost / Missing</option>
          <option value="correction">Correction</option>
        </select>
      </label>
      <label>Quantity <input class="ainput" type="number" name="quantity" min="1" required /></label>
      <label>Note <input class="ainput" type="text" name="note" placeholder="Optional remarks" /></label>
      <button type="submit" class="abtn abtn-dark">Submit Report</button>
    </form>
  </div>

  <div class="panel">
    <h2 class="panel-title">Current Stock</h2>
    <div class="table-wrap">
    <table class="atable">
      <thead><tr><th>Product</th><th>Stock</th><th>Reorder Level</th></tr></thead>
      <tbody>
        <% products.forEach(p => { %>
          <tr class="<%= p.stock_quantity <= p.reorder_level ? 'row-warning' : '' %>">
            <td><%= p.name %></td>
            <td><%= p.stock_quantity %> <%= p.unit %></td>
            <td><%= p.reorder_level %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  </div>

  <div class="panel">
    <h2 class="panel-title">My Recent Reports</h2>
    <% if (myReports.length === 0) { %>
      <p class="muted">You haven't submitted any reports yet.</p>
    <% } else { %>
      <div class="table-wrap">
    <table class="atable">
        <thead><tr><th>Product</th><th>Type</th><th>Change</th><th>Note</th><th>When</th></tr></thead>
        <tbody>
          <% myReports.forEach(r => { %>
            <tr>
              <td><%= r.product_name %></td>
              <td><%= r.type %></td>
              <td><%= r.quantity_change > 0 ? '+' : '' %><%= r.quantity_change %></td>
              <td><%= r.note || '—' %></td>
              <td><%= r.created_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</main>
<%- include('../partials/foot') %>
